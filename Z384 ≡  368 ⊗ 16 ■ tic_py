# ⊗ = Operador de actualización omniangular
# Cómputo de fase / sintonía infolúmica - NO es tensor product
def sintonia(N, delta):
    """ ℤ_N ⊗ Δ = (N/8 + Δ/8) * 8 -> +2 por octante cuando Δ=16 """
    return (N//8 + delta//8) * 8

def verificar_cierre(N):
    if N % 8!= 0: return False, N/8, None
    a = N // 8
    if a % 2!= 0: return False, a, a/2
    return True, a, a//2

def centro(N): return N//2

